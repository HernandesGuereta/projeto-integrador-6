{
  "testEnvironment": "node",
  "clearMocks": true,
  "collectCoverage": true,
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/index.ts",
    "!src/config/database.ts",
    "!src/client/**/*.ts"
  ],
  "coverageDirectory": "coverage",
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
  },
  "coverageThreshold": {
    "global": {
      "branches": 90,
      "functions": 90,
      "lines": 90,
      "statements": 90
    }
  }
}

