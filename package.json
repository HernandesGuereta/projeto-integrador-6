{
  "name": "projeto-integrador-6",
  "version": "1.0.0",
  "description": "API e interface em TypeScript para gerenciamento de produtos com Express, Sequelize e SQLite",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.build.json",
    "build:client": "tsc -p tsconfig.client.json",
    "start": "npm run build && node dist/index.js",
    "dev": "npm run build:client && tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.json --coverage --runInBand",
    "test:watch": "jest --config jest.config.json --watch"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.2.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}

